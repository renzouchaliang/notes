---
import '../styles/global.css';
interface Props { title: string; description: string; lang?: string }
const { title, description, lang = 'zh-CN' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Notes</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content / 跳至正文</a>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label="Notes homepage"><span class="brand-mark">n.</span> Notes<span class="brand-cn"> / 手记</span></a>
      <a class="archive-link" href="/">All writing <span aria-hidden="true">↗</span></a>
    </header>
    <slot />
    <footer class="site-footer wrap"><span>Notes / 手记</span><span>A quiet place for ideas. 为思考留一处空间。</span></footer>
  </body>
</html>
